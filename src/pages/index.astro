---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { topics } from '../data/topics';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featured = articles.filter((article) => article.data.featured).slice(0, 3);
const latest = articles.slice(0, 6);
---
<BaseLayout>
  <section class="hero">
    <p class="eyebrow">A space for ideas</p>
    <h1>Ideas worth<br /><em>sharing.</em></h1>
    <p class="lead">Knowledge, experiments, stories, games and things worth exploring — collected in one place.</p>
    <a class="explore" href="#topics">Explore topics <span>↓</span></a>
  </section>

  <section id="topics" class="section">
    <div class="section-head"><p class="eyebrow">Explore</p><a href="/topics">View all →</a></div>
    <div class="topic-grid">
      {topics.map((topic, i) => (
        <a class="topic" href={`/topics/${topic.slug}`}>
          <span class="number">{String(i + 1).padStart(2, '0')}</span>
          <div><h2>{topic.name}</h2><p>{topic.description}</p></div><span class="arrow">↗</span>
        </a>
      ))}
    </div>
  </section>

  {featured.length > 0 && <section class="section"><div class="section-head"><p class="eyebrow">Featured</p></div><div class="article-grid">{featured.map((article) => <a class="card" href={`/articles/${article.id}`}><span class="type">{article.data.type}</span><h3>{article.data.title}</h3><p class="muted">{article.data.description}</p><small>{article.data.pubDate.toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'})}</small></a>)}</div></section>}

  <section class="section"><div class="section-head"><p class="eyebrow">Latest</p><a href="/articles">All articles →</a></div><div class="latest">{latest.map((article) => <a class="latest-item" href={`/articles/${article.id}`}><div><span class="type">{article.data.type}</span><h3>{article.data.title}</h3><p>{article.data.description}</p></div><time>{article.data.pubDate.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})}</time></a>)}</div></section>
</BaseLayout>

<style>
.hero{padding:110px 0 130px;max-width:850px}.hero h1{font-size:clamp(4rem,10vw,8rem);line-height:.88;margin:20px 0 30px}.hero h1 em{font-style:normal;color:#77777e}.lead{max-width:570px;font-size:1.15rem;color:#94949b;line-height:1.7}.explore{display:inline-flex;gap:20px;margin-top:32px;padding:13px 18px;border:1px solid #303035;border-radius:999px;color:#ddd}.explore:hover{background:#171719}.section{margin-top:30px;padding:55px 0}.section-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}.section-head a{color:#85858c;font-size:.85rem}.topic-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:#222226;border:1px solid #222226}.topic{background:#0d0d0f;padding:30px;min-height:180px;display:grid;grid-template-columns:35px 1fr 25px;gap:12px}.topic:hover{background:#121214}.topic h2{font-size:1.45rem;margin:0 0 8px}.topic p{margin:0;color:#77777e;line-height:1.55;font-size:.9rem}.number,.arrow{color:#5e5e65;font-size:.72rem}.arrow{font-size:1rem}.article-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.card h3{font-size:1.35rem;margin:15px 0 10px}.card small{color:#66666c}.type{font-size:.68rem;text-transform:uppercase;letter-spacing:.12em;color:#77777e}.latest{border-top:1px solid #222226}.latest-item{display:flex;justify-content:space-between;gap:30px;padding:24px 0;border-bottom:1px solid #222226}.latest-item h3{margin:8px 0}.latest-item p{margin:0;color:#77777e}.latest-item time{white-space:nowrap;color:#66666c;font-size:.78rem;padding-top:3px}@media(max-width:700px){.hero{padding:75px 0 80px}.topic-grid,.article-grid{grid-template-columns:1fr}.latest-item{display:block}.latest-item time{display:block;margin-top:12px}}
</style>
