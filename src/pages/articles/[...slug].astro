---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}
const { article } = Astro.props;
const { Content } = await render(article);
---
<BaseLayout title={`${article.data.title} — Cuu Pham`} description={article.data.description}>
  <article class="article">
    <a class="back" href={`/topics/${article.data.topic}`}>← Back to topic</a>
    <header><span class="type">{article.data.type}</span><h1>{article.data.title}</h1><p class="dek">{article.data.description}</p><time>{article.data.pubDate.toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'})}</time></header>
    <div class="content"><Content /></div>
  </article>
</BaseLayout>
<style>.article{max-width:760px;margin:0 auto;padding:80px 0}.back{color:#777;font-size:.85rem}.article header{padding:70px 0 55px;border-bottom:1px solid #222226}.article h1{font-size:clamp(2.8rem,7vw,5.5rem);line-height:.95;margin:18px 0 25px}.dek{font-size:1.15rem;line-height:1.7;color:#888}.article time{display:block;margin-top:25px;color:#666;font-size:.8rem}.content{padding-top:50px;font-size:1.05rem;line-height:1.85;color:#c1c1c5}.content :global(h2){font-size:1.8rem;margin-top:55px;color:#eee}.content :global(h3){font-size:1.35rem;margin-top:40px;color:#eee}.content :global(a){text-decoration:underline;text-underline-offset:3px}.content :global(code){background:#171719;padding:3px 6px;border-radius:5px}.content :global(pre){background:#111113;border:1px solid #242428;padding:18px;border-radius:10px;overflow:auto}.content :global(blockquote){margin:30px 0;padding-left:20px;border-left:2px solid #444;color:#999}</style>
