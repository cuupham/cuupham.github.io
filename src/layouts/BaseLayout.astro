---
const { title = 'Cuu Pham — Ideas worth sharing', description = 'A collection of knowledge, ideas, stories, games and things worth exploring.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">CUU<span>.</span></a>
      <nav aria-label="Main navigation">
        <a href="/topics">Topics</a>
        <a href="/articles">Articles</a>
        <a href="/about">About</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <span>Ideas worth sharing.</span>
      <span>© {new Date().getFullYear()}</span>
    </footer>
  </body>
</html>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');
  :root { font-family: 'DM Sans', system-ui, sans-serif; color: #e9e9e9; background: #0b0b0c; font-synthesis: none; }
  * { box-sizing: border-box; }
  body { margin: 0; min-width: 320px; background: radial-gradient(circle at 50% -20%, #202023 0, #0b0b0c 45%); }
  a { color: inherit; text-decoration: none; }
  .site-header { max-width: 1180px; margin: auto; padding: 28px 24px; display:flex; justify-content:space-between; align-items:center; }
  .brand { font-family:'Space Grotesk'; font-weight:700; letter-spacing:-.05em; font-size:1.2rem; }
  .brand span { color:#8d8d92; }
  nav { display:flex; gap:28px; color:#99999f; font-size:.9rem; }
  nav a:hover { color:#fff; }
  main { max-width:1180px; margin:auto; padding:0 24px 80px; }
  .site-footer { max-width:1180px; margin:auto; padding:28px 24px 50px; display:flex; justify-content:space-between; color:#66666c; font-size:.8rem; border-top:1px solid #1d1d20; }
  .eyebrow { color:#77777e; text-transform:uppercase; letter-spacing:.16em; font-size:.72rem; font-weight:600; }
  h1,h2,h3 { font-family:'Space Grotesk',sans-serif; letter-spacing:-.04em; }
  .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:12px; }
  .card { border:1px solid #222226; background:#111113; border-radius:14px; padding:22px; transition:.2s ease; }
  .card:hover { border-color:#414147; transform:translateY(-2px); }
  .muted { color:#85858c; line-height:1.65; }
  @media(max-width:650px){ nav{gap:14px}.site-header{padding:22px 18px}main{padding:0 18px 60px}.site-footer{padding:24px 18px} }
</style>
