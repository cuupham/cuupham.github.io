{
  "name": "U.U.C Design Tokens",
  "version": "1.0.0",
  "source": "design-system/MASTER.md",
  "layers": {
    "primitive": {
      "color": {
        "ink": "#171817",
        "ink-soft": "#686962",
        "ink-faint": "#96958d",
        "paper": "#f5f4ef",
        "surface": "#fffefa",
        "surface-muted": "#ebe9e1",
        "accent": "#5f55d9",
        "accent-cool": "#43d9ff",
        "line": "#ddd9ce",
        "line-strong": "#bcb6a8",
        "code-bg": "#111318",
        "code-fg": "#f2f0e9"
      },
      "space": {
        "1": "4px",
        "2": "8px",
        "3": "12px",
        "4": "16px",
        "5": "20px",
        "6": "24px",
        "8": "32px",
        "10": "40px",
        "12": "48px",
        "16": "64px",
        "20": "80px"
      },
      "radius": {
        "sm": "8px",
        "md": "16px",
        "lg": "24px",
        "pill": "999px"
      },
      "font": {
        "display": "Space Grotesk, Inter, ui-sans-serif, system-ui, sans-serif",
        "body": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
        "mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, Liberation Mono, monospace"
      },
      "type": {
        "display-min": "2.5rem",
        "display-max": "5rem",
        "body": "1.05rem",
        "small": "0.78rem",
        "label": "0.68rem"
      },
      "motion": {
        "fast": "140ms",
        "normal": "240ms",
        "ease": "cubic-bezier(.22, 1, .36, 1)"
      },
      "shadow": {
        "subtle": "0 1px 2px rgb(24 25 23 / 5%)",
        "card": "0 14px 36px rgb(24 25 23 / 8%)"
      }
    },
    "semantic": {
      "color": {
        "canvas": "var(--color-paper)",
        "surface": "var(--color-surface)",
        "surface-muted": "var(--color-surface-muted)",
        "text-primary": "var(--color-ink)",
        "text-secondary": "var(--color-ink-soft)",
        "text-tertiary": "var(--color-ink-faint)",
        "border": "var(--color-line)",
        "border-strong": "var(--color-line-strong)",
        "brand": "var(--color-accent)",
        "brand-cool": "var(--color-accent-cool)",
        "code-surface": "var(--color-code-bg)",
        "code-text": "var(--color-code-fg)"
      },
      "space": {
        "section": "var(--space-16)",
        "stack": "var(--space-6)",
        "inline": "var(--space-3)",
        "compact": "var(--space-2)"
      },
      "type": {
        "display": "var(--font-display)",
        "body": "var(--font-body)",
        "mono": "var(--font-mono)",
        "reading-size": "var(--type-body)",
        "reading-leading": "1.88"
      }
    },
    "component": {
      "article": {
        "max-width": "980px",
        "reading-max": "720px",
        "header-padding": "var(--space-12) clamp(var(--space-6), 5vw, var(--space-16))",
        "title-size": "clamp(var(--type-display-min), 6vw, var(--type-display-max))",
        "row-height": "128px",
        "row-gap": "var(--space-6)",
        "row-indent": "var(--space-12)",
        "meta-gap": "var(--space-2)",
        "divider": "var(--color-line)",
        "tag-radius": "var(--radius-pill)",
        "header-radius": "var(--radius-lg)",
        "code-radius": "var(--radius-md)",
        "focus-ring": "0 0 0 4px color-mix(in srgb, var(--color-accent) 18%, transparent)"
      },
      "brand": {
        "primary": "var(--color-accent)",
        "gradient-start": "#7c5cff",
        "gradient-mid": "#5f9bff",
        "gradient-end": "#43d9ff",
        "mark-size": "30px",
        "gap": "10px",
        "wordmark-size": "1.08rem",
        "wordmark-weight": "760",
        "descriptor-size": "0.62rem"
      }
    }
  }
}
